<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>SpigenAudioCTRL</RootNamespace>
    <AssemblyName>SpigenAudioCTRL</AssemblyName>
    <Product>Spigen Audio CTRL</Product>
    <Title>Spigen Audio CTRL</Title>
    <Version>2.0.0</Version>
    <!-- Publishing options (single file, self-contained or not) are passed by build.bat and CI.
         PublishTrimmed stays off: WPF loads XAML types by reflection and trimming breaks it. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and WinForms share type names (Button, Application...); keep WinForms out of global usings. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**" />
  </ItemGroup>

</Project>
