<UserControl x:Class="SpigenAudioCTRL.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style x:Key="CardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"/>
            <TextBlock Text="Headset options stored on the headphones, and app preferences" FontSize="12.5" Foreground="#888888" Margin="0,3,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">

                <!-- Headset-stored options -->
                <StackPanel x:Name="headsetOptions">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Channel Balance" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="txtBalance" Text="Centered" Foreground="#CCCCCC" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Shifts volume between the left and right ear cups" Style="{StaticResource CardHint}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="L" Foreground="#999999" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider Grid.Column="1" x:Name="sliderBalance" Style="{StaticResource NordicHorizontalSliderStyle}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                        IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Balance_ValueChanged" AutomationProperties.Name="Channel balance, left to right"/>
                                <TextBlock Grid.Column="2" Text="R" Foreground="#999999" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,12,0"/>
                                <Button Grid.Column="3" Style="{StaticResource NordicButtonStyle}" Content="Center" Click="CenterBalance_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Sleep Timer" Style="{StaticResource CardTitle}"/>
                            <TextBlock Text="Turns the headphones off after the chosen time" Style="{StaticResource CardHint}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <RadioButton x:Name="timerOff" GroupName="SleepTimer" Style="{StaticResource NordicSegmentStyle}" Content="Off" Tag="65535" Checked="Timer_Checked"/>
                                <RadioButton GroupName="SleepTimer" Style="{StaticResource NordicSegmentStyle}" Content="15 min" Tag="15" Checked="Timer_Checked"/>
                                <RadioButton GroupName="SleepTimer" Style="{StaticResource NordicSegmentStyle}" Content="30 min" Tag="30" Checked="Timer_Checked"/>
                                <RadioButton GroupName="SleepTimer" Style="{StaticResource NordicSegmentStyle}" Content="60 min" Tag="60" Checked="Timer_Checked"/>
                                <RadioButton GroupName="SleepTimer" Style="{StaticResource NordicSegmentStyle}" Content="90 min" Tag="90" Checked="Timer_Checked"/>
                            </StackPanel>
                            <TextBlock x:Name="txtTimer" Text="" Style="{StaticResource CardHint}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Headset" Style="{StaticResource CardTitle}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Restore default settings" Foreground="#DDDDDD" FontSize="12.5"/>
                                    <TextBlock Text="Resets noise control, equalizer and buttons to factory settings" Style="{StaticResource CardHint}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource NordicButtonStyle}" Content="Restore..." Click="Restore_Click" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Clear pairing records" Foreground="#DDDDDD" FontSize="12.5"/>
                                    <TextBlock Text="Forgets paired phones and PCs; you will need to pair the headphones again" Style="{StaticResource CardHint}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource NordicButtonStyle}" Content="Clear..." Click="ClearPairing_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- App preferences -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="App" Style="{StaticResource CardTitle}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Launch with Windows" Foreground="#DDDDDD" FontSize="12.5"/>
                                <TextBlock Text="Starts minimized in the notification area when you sign in" Style="{StaticResource CardHint}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="chkStartup" Style="{StaticResource NordicToggleSwitchStyle}" Click="Startup_Click" AutomationProperties.Name="Launch with Windows"/>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Keep running in the notification area" Foreground="#DDDDDD" FontSize="12.5"/>
                                <TextBlock Text="Closing the window leaves the app in the tray for quick switching" Style="{StaticResource CardHint}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" x:Name="chkCloseToTray" Style="{StaticResource NordicToggleSwitchStyle}" Click="CloseToTray_Click" AutomationProperties.Name="Keep running in the notification area"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="About &amp; Diagnostics" Style="{StaticResource CardTitle}"/>
                        <TextBlock x:Name="txtVersion" Style="{StaticResource CardHint}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource NordicButtonStyle}" Content="Copy log" Margin="0,0,6,0" Click="CopyLog_Click" ToolTip="Copy the diagnostic log, for example to attach to a bug report"/>
                            <Button Style="{StaticResource NordicButtonStyle}" Content="Open log folder" Click="OpenLogFolder_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
