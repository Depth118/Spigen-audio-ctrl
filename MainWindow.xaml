<Window x:Class="SpigenAudioCTRL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SpigenAudioCTRL.Views"
        Title="Spigen Audio CTRL"
        Icon="Assets/app.ico"
        Height="680" Width="1020"
        MinHeight="580" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0A"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="#0A0A0A">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Background="#0E0E0E">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Image Source="Assets/logo.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Spigen Audio CTRL" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>

                <!-- Transient status message (failed or unconfirmed commands) -->
                <TextBlock x:Name="txtToast" Foreground="#E5A93C" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButtonStyle}" Click="Minimize_Click" Width="46" Height="40" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                    <Path Data="M1,6 L11,6" Stroke="#999999" StrokeThickness="1" Width="10" Height="10" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource CaptionButtonStyle}" Click="Maximize_Click" Width="46" Height="40" ToolTip="Maximize" AutomationProperties.Name="Maximize">
                    <Path x:Name="maximizeIcon" Data="M1.5,1.5 H10.5 V10.5 H1.5 Z" Stroke="#999999" StrokeThickness="1" Width="10" Height="10" Stretch="Uniform"/>
                </Button>
                <Button Style="{StaticResource CloseCaptionButtonStyle}" Click="Close_Click" Width="46" Height="40" ToolTip="Close" AutomationProperties.Name="Close">
                    <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="#999999" StrokeThickness="1" Width="10" Height="10" Stretch="Uniform"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body: Navigation Rail + Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0E0E0E" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Device Card -->
                    <Border Grid.Row="0" Margin="12,14,12,10" Background="#141414" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="28" Height="28" CornerRadius="4" Background="#1A1A1A" Margin="0,0,10,0">
                                <Path Data="M3,18 V12 A9,9 0 0,1 21,12 V18 A2,2 0 0,1 19,20 H18 A2,2 0 0,1 16,18 V15 A2,2 0 0,1 18,13 H21 V12 A9,9 0 0,0 3,12 V13 H6 A2,2 0 0,1 8,15 V18 A2,2 0 0,1 6,20 H5 A2,2 0 0,1 3,18 Z"
                                      Stroke="#FFFFFF" StrokeThickness="1.2" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Spigen SA-HP P10" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Ellipse x:Name="statusDot" Width="6" Height="6" Fill="#E63946" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtStatus" Text="Not connected" Foreground="#999999" FontSize="10.5" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                                <TextBlock x:Name="txtBattery" Foreground="#52B788" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Navigation -->
                    <StackPanel Grid.Row="1" Margin="6,6,6,0">
                        <RadioButton x:Name="navAnc" Style="{StaticResource NavRailItemStyle}" IsChecked="True" Checked="Nav_Checked" AutomationProperties.Name="Noise Control">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M2,12 L5,5 L9,19 L13,3 L17,21 L21,8 L23,12" Stroke="#CCCCCC" StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Noise Control" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="navEq" Style="{StaticResource NavRailItemStyle}" Checked="Nav_Checked" AutomationProperties.Name="Equalizer">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M4,21 V14 M4,10 V3 M12,21 V12 M12,8 V3 M20,21 V16 M20,12 V3 M1,14 H7 M9,8 H15 M17,16 H23" Stroke="#CCCCCC" StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="10-Band Equalizer" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="navButtons" Style="{StaticResource NavRailItemStyle}" Checked="Nav_Checked" AutomationProperties.Name="Button Remapping">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M5,6 H19 A3,3 0 0,1 22,9 V15 A3,3 0 0,1 19,18 H5 A3,3 0 0,1 2,15 V9 A3,3 0 0,1 5,6 Z M7.5,12 A1.5,1.5 0 1,1 7.5,11.99 Z M12,12 A1.5,1.5 0 1,1 12,11.99 Z M16.5,12 A1.5,1.5 0 1,1 16.5,11.99 Z" Stroke="#CCCCCC" StrokeThickness="1.2" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Button Remapping" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="navSettings" Style="{StaticResource NavRailItemStyle}" Checked="Nav_Checked" AutomationProperties.Name="Settings">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M12,8 A4,4 0 1,1 11.99,8 Z M12,1 V4 M12,20 V23 M1,12 H4 M20,12 H23 M4.2,4.2 L6.3,6.3 M17.7,17.7 L19.8,19.8 M4.2,19.8 L6.3,17.7 M17.7,6.3 L19.8,4.2" Stroke="#CCCCCC" StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Connect / Disconnect -->
                    <Border Grid.Row="2" Padding="12,14" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0">
                        <Button Style="{StaticResource NordicOutlineButtonStyle}" Click="ConnectAction_Click" HorizontalAlignment="Stretch" Height="34">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M18.36,6.64 A9,9 0 1,1 5.64,6.64 M12,2 V12" Stroke="#888888" StrokeThickness="1.3" Width="11" Height="11" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtConnectAction" Text="Connect" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="#0A0A0A" Margin="28,22,28,24">
                <views:NoiseControlView x:Name="noiseView"/>
                <views:EqualizerView x:Name="eqView" Visibility="Collapsed"/>
                <views:ButtonsView x:Name="buttonsView" Visibility="Collapsed"/>
                <views:SettingsView x:Name="settingsView" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
